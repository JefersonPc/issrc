    (English: 'Commercial license key has been removed.'; Localized: 'A chave de licença comercial foi removida.'),
    (English: 'Your version of Inno Setup has been updated! <a id="%1">See what''s new</a>.'; Localized: 'Sua versão do Inno Setup foi atualizada! <a id="%1">Veja o que há de novo</a>.'),
    (English: 'VS Code-style editor shortcuts added! Use the <a id="%1">Editor Keys option</a> in Options dialog.'; Localized: 'Atalhos de editor no estilo VS Code adicionados! Use a <a id="%1">opção Teclas do Editor</a> na caixa de diálogo Opções.'),
    (English: 'RTF Editor added, a built-in WordPad replacement! Use the <a id="%1">RTF Editor item</a> in Tools menu.'; Localized: 'Editor RTF adicionado, um substituto integrado do WordPad! Use o <a id="%1">item Editor RTF</a> no menu Ferramentas.'),
    (English: 'Inno Setup Compiler is available in your language! Use the <a id="%1">Language option</a> in Options dialog.'; Localized: 'O Compilador do Inno Setup está disponível no seu idioma! Use a <a id="%1">opção de Idioma</a> na caixa de diálogo Opções.'),
    (English: '<a id="%1">Ideas board is open!</a> Share your ideas and vote on others, this month only.'; Localized: '<a id="%1">O painel de ideias está aberto!</a> Compartilhe suas ideias e vote em outras, apenas este mês.'),
    (English: 'Running a version released after your update entitlement ended. <a id="%1">Renew license</a>, <a id="%2">remove key</a>, or <a id="%3">exit</a>.'; Localized: 'Executando uma versão lançada após o término do seu direito de atualização. <a id="%1">Renovar licença</a>, <a id="%2">remover chave</a> ou <a id="%3">sair</a>.'),
    (English: 'Your update entitlement is ending soon. Please <a id="%1">renew your license</a>. Thanks!'; Localized: 'Seu direito de atualização terminará em breve. Por favor, <a id="%1">renove sua licença</a>. Obrigado!'),
